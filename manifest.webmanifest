{
  "name": "Merlin Professzionális Kabinetfőnök",
  "short_name": "Merlin",
  "description": "Egy érintés, és már írhat vagy beszélhet is Merlinnel.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0a1421",
  "theme_color": "#101c2d",
  "lang": "hu",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "images",
          "accept": [
            "image/jpeg",
            "image/png",
            "image/webp"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
